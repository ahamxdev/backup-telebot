# =============================================================================
# Security
# =============================================================================

# Set production for Docker deployments (requires PostgreSQL and all credentials).
APP_ENV=development
# Generate once with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY_B64=

# =============================================================================
# PostgreSQL
# =============================================================================

# Local non-Compose runs may override this with a sqlite+aiosqlite URL.
DATABASE_URL=sqlite+aiosqlite:///./.runtime/data/app.sqlite3
# Docker Compose constructs its production DATABASE_URL from these values.
POSTGRES_DB=backup_telebot
POSTGRES_USER=backup_telebot
# Generate a long random value; never commit the production password.
POSTGRES_PASSWORD=
# Root containing versioned PostgreSQL client directories such as 15/bin.
POSTGRES_CLIENT_ROOT=/usr/lib/postgresql

# =============================================================================
# Telegram
# =============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# One or more comma-separated positive Telegram user IDs.
SUPERADMIN_TELEGRAM_IDS=
TELEGRAM_SUPERADMIN_LANGUAGE=en
TELEGRAM_SESSION_PATH=./.runtime/telegram/telegram.session
TELEGRAM_WORKER_SESSION_PATH=./.runtime/telegram/worker.session
# Maximum size of each Telegram file; larger final artifacts are split.
TELEGRAM_MAX_FILE_BYTES=2000000000
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=7200
# Durable per-part attempt budget, exponential backoff and bounded jitter.
# After exhaustion: operator Retry Delivery before retained-artifact expiry.
TELEGRAM_MAX_DELIVERY_ATTEMPTS=10
TELEGRAM_RETRY_BASE_SECONDS=30
TELEGRAM_RETRY_MAX_SECONDS=3600
TELEGRAM_RETRY_JITTER_SECONDS=15

# =============================================================================
# Proxy
# =============================================================================

TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
# On Linux, a host proxy can use host.docker.internal (Compose host-gateway).
# It must listen on an interface reachable from the Docker bridge.
# Set both proxy credentials together, or leave both empty.
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# =============================================================================
# Runtime / Backup
# =============================================================================

# Telegram conversation lifetime and abuse limits.
FSM_TIMEOUT_SECONDS=900
USER_RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=300
INVALID_INPUT_LIMIT=5
LOG_LEVEL=INFO
LOG_FORMAT=console
DATA_DIR=./.runtime/data
WORK_ROOT=./.runtime/work
PENDING_DELIVERY_ROOT=./.runtime/pending-delivery
# Comma-separated paths visible inside the worker and approved as local sources.
ALLOWED_SOURCE_ROOTS=/srv/backups
# Comma-separated host-path:worker-path mappings matching actual Compose bind mounts.
# Mount local sources only in Worker, never Bot. Narrow the read-only /etc example.
LOCAL_SOURCE_MOUNTS=/etc:/host/etc
# Bot/Worker private preflight socket; Compose overrides this into shared /data/runtime.
LOCAL_SOURCE_VALIDATION_SOCKET=./.runtime/data/source-validation/worker.sock
# Protected roots that must never be accepted as backup sources.
DENIED_SOURCE_ROOTS=/proc,/sys,/dev,/run,/data/runtime
MAX_CONCURRENT_BACKUPS=2
MAX_CONCURRENT_REMOTE_TRANSFERS=2
MAX_BACKUP_RUNTIME_SECONDS=21600
# Durable job ownership and polling cadence.
JOB_LEASE_SECONDS=120
WORKER_POLL_SECONDS=2
# Source traversal and capacity safety limits.
MIN_FREE_DISK_BYTES=5000000000
MAX_SOURCE_BYTES_PER_RUN=100000000000
MAX_SOURCE_FILES_PER_RUN=100000
MAX_SOURCE_DIRECTORY_DEPTH=64
MAX_SOURCE_SINGLE_FILE_BYTES=20000000000
MAX_PENDING_DELIVERY_BYTES=50000000000
# How long verified artifacts from failed runs remain available for retry.
FAILED_ARTIFACT_RETENTION_SECONDS=604800
UPLOAD_PROGRESS_INTERVAL_SECONDS=5

# =============================================================================
# Health
# =============================================================================

HEALTH_HEARTBEAT_INTERVAL_SECONDS=30
HEALTH_WORKER_STALE_SECONDS=120
HEALTH_SCHEDULER_STALE_SECONDS=300
HEALTH_TELEGRAM_STALE_SECONDS=120

# =============================================================================
# Local GitLab Helper
# =============================================================================

# Private Unix socket shared only by the worker and optional helper profile.
GITLAB_HELPER_SOCKET=/run/gitlab-helper/helper.sock
# Informational helper-visible root; Compose supplies this to bot/worker/helper.
# For non-Compose deployments, set it to the helper's actual GITLAB_BACKUP_ROOT.
# GITLAB_BACKUP_ROOT=/gitlab-backups
# Host directory used by the single gitlab-helper bind mount in Compose.
GITLAB_BACKUP_HOST_PATH=/opt/gitlab/data/backups
# Require an unchanged native artifact across this many checks.
GITLAB_STABILITY_INTERVAL_SECONDS=1
GITLAB_STABILITY_CHECKS=2
# Optional helper-only supplementary group; root helper normally needs no host GID.
DOCKER_GID=999
# =============================================================================
# Container Resources
# =============================================================================

CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2.0
