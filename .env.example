APP_ENV=development
# Generate once with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY_B64=
DATABASE_URL=sqlite+aiosqlite:///./.runtime/data/app.sqlite3
# Docker Compose constructs the production DATABASE_URL from these values.
POSTGRES_DB=backup_telebot
POSTGRES_USER=backup_telebot
# Generate a long random value; never commit the production password.
POSTGRES_PASSWORD=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERADMIN_ID=
TELEGRAM_SUPERADMIN_LANGUAGE=en
TELEGRAM_SESSION_PATH=./.runtime/telegram/telegram.session
TELEGRAM_WORKER_SESSION_PATH=./.runtime/telegram/worker.session
TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_MAX_UPLOAD_BYTES=2000000000
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=7200
TELEGRAM_MAX_DELIVERY_ATTEMPTS=10
TELEGRAM_RETRY_BASE_SECONDS=30
TELEGRAM_RETRY_MAX_SECONDS=3600
TELEGRAM_RETRY_JITTER_SECONDS=15
FSM_TIMEOUT_SECONDS=900
USER_RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=300
INVALID_INPUT_LIMIT=5
LOG_LEVEL=INFO
LOG_FORMAT=console
DATA_DIR=./.runtime/data
ALLOWED_SOURCE_ROOTS=/srv/backups
LOCAL_SOURCE_MOUNTS=
DENIED_SOURCE_ROOTS=/proc,/sys,/dev,/run,/data/state,/data/work,/data/pending-delivery,/data/telegram
WORK_ROOT=./.runtime/work
PENDING_DELIVERY_ROOT=./.runtime/pending-delivery
MAX_CONCURRENT_BACKUPS=2
MAX_CONCURRENT_REMOTE_TRANSFERS=2
MAX_BACKUP_RUNTIME_SECONDS=21600
JOB_LEASE_SECONDS=120
WORKER_POLL_SECONDS=2
HEALTH_HEARTBEAT_INTERVAL_SECONDS=30
HEALTH_WORKER_STALE_SECONDS=120
HEALTH_SCHEDULER_STALE_SECONDS=300
HEALTH_TELEGRAM_STALE_SECONDS=120
MIN_FREE_DISK_BYTES=5000000000
MAX_SOURCE_BYTES_PER_RUN=100000000000
MAX_SOURCE_FILES_PER_RUN=100000
MAX_SOURCE_DIRECTORY_DEPTH=64
MAX_SOURCE_SINGLE_FILE_BYTES=20000000000
MAX_PENDING_DELIVERY_BYTES=50000000000
FAILED_ARTIFACT_RETENTION_SECONDS=604800
UPLOAD_PROGRESS_INTERVAL_SECONDS=5
POSTGRES_CLIENT_ROOT=/usr/lib/postgresql
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2.0
